+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""merge_lake_coverage.py — 湖侧覆盖清单合并进本地 image.jsonl（集群侧，2026-09-08）。
+
+背景：湖机器图片部分还原（Sep 5 备份抽取 + 本地收割），导出
+lake_coverage_for_cluster.jsonl（本仓 schema：concepts 字段）。合并进本地
+清单后，flow 的三处机制立即按湖内覆盖工作，补采不重下：
+  ① load_coverage + --skip-covered N：概念已有 ≥N 张合格图即跳过；
+  ② 配额循环 concept_coverage：bench 批任务概念配额按合并后计数收敛；
+  ③ sink load_index 的 (sha256, concept) 去重：湖内已有内容直接跳过落盘。
+
+幂等：按 (sha256, concept) 键去重合并，重复执行不产生重复行。
+
+用法：
+  python3 merge_lake_coverage.py lake_coverage_for_cluster.jsonl            # 默认清单
+  python3 merge_lake_coverage.py <file> --dataset ~/datasets/demiwtg        # 指定数据集根
+  python3 merge_lake_coverage.py <file> --dry-run                           # 只看会并入多少
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import tempfile
+
+REPO_ROOT = os.path.dirname(os.path.abspath(__file__))
+DEFAULT_DATASET = os.path.join(REPO_ROOT, "datasets", "demiwtg")
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description="湖侧覆盖清单合并（幂等，(sha,concept) 去重）")
+    ap.add_argument("src", help="lake_coverage_for_cluster.jsonl 路径")
+    ap.add_argument("--dataset", default=DEFAULT_DATASET,
+                    help="清单/状态根（默认本仓 datasets/demiwtg）")
+    ap.add_argument("--dry-run", action="store_true", help="只统计不写盘")
+    args = ap.parse_args()
+
+    manifest = os.path.join(args.dataset, "meta", "image.jsonl")
+
+    have = set()
+    if os.path.exists(manifest):
+        with open(manifest, encoding="utf-8") as f:
+            for line in f:
+                line = line.strip()
+                if not line:
+                    continue
+                try:
+                    rec = json.loads(line)
+                except json.JSONDecodeError:
+                    continue
+                for c in rec.get("concepts") or [""]:
+                    have.add((rec.get("sha256"), c))
+    base = len(have)
+
+    merged = 0
+    tmp = manifest + ".tmp"
+    with open(args.src, encoding="utf-8") as f, \
+            open(tmp, "a", encoding="utf-8") if not args.dry_run else open(os.devnull, "w") as out:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            rec = json.loads(line)
+            keys = [(rec.get("sha256"), c) for c in rec.get("concepts") or [""]]
+            if all(k in have for k in keys):
+                continue                      # 完全已知（幂等重跑）
+            merged += 1
+            if not args.dry_run:
+                out.write(json.dumps(rec, ensure_ascii=False) + "\n")
+            have.update(keys)
+    if args.dry_run:
+        if os.path.exists(tmp):
+            os.remove(tmp)
+        print(f"[dry-run] 清单 {manifest}：既有 {base:,} 键，将并入 {merged:,} 行")
+        return
+    os.replace(tmp, manifest)
+    print(f"[merge] {manifest}：既有 {base:,} 键，并入 {merged:,} 行（幂等可重跑）")
+    print("[next] flow 照常跑：--skip-covered N / 配额循环 / sink 去重已按合并后覆盖工作")
+
+
+if __name__ == "__main__":
+    main()
