diff --git a/flow.py b/flow.py
index 2485749..008cfe4 100644
--- a/flow.py
+++ b/flow.py
@@ -42,6 +42,10 @@ def parse_args() -> argparse.Namespace:
     p.add_argument("--instances", default=DEFAULT_INSTANCES)
     p.add_argument("--concepts", default="",
                    help="概念批任务模式：concepts_batch json（优先于 --instances）")
+    p.add_argument("--concepts-docs", default="",
+                   help="概念 docs sidecar（jsonl: {name, body}）：概念模式打标 kb 的"
+                        "知识文本来源；缺省用 <批文件>.docs.jsonl 伴随文件，"
+                        "缺失退化=仅凭名称判断")
     p.add_argument("--docs-pages", type=int, default=20,
                    help="docs 线每概念页面配额（默认 20）")
     p.add_argument("--quota-passes", type=int, default=2,
@@ -101,6 +105,37 @@ def load_coverage(dataset_dir: str, *, min_quality: float = 0,
                        key_of=lambda r: r.get("concepts") or [])
 
 
+def _docs_sibling(batch_path: str) -> str:
+    """概念批文件的 docs 伴随文件路径（<批文件去后缀>.docs.jsonl）。"""
+    root, _ = os.path.splitext(batch_path)
+    return root + ".docs.jsonl"
+
+
+def load_concepts_docs(path: str) -> dict:
+    """docs 层 sidecar（jsonl: {name, body}）→ {概念名: 知识文本}。
+
+    概念行不含知识文本（四字段契约：name/aliases/carriers/taxonomy），
+    概念模式打标 kb 的 desc 自此注入；文件缺失返回空表。
+    """
+    import json
+    docs: dict = {}
+    if not path or not os.path.exists(path):
+        return docs
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                r = json.loads(line)
+            except json.JSONDecodeError:
+                continue
+            name = (r.get("name") or "").strip()
+            if name:
+                docs[name] = (r.get("body") or "").strip()
+    return docs
+
+
 def prepare_inputs(args) -> dict:
     """加载与筛选：概念/实例 → 覆盖过滤 → 分片 → 切片（纯数据准备）。"""
     from operators import search, concepts as concepts_mod
@@ -178,8 +213,11 @@ def image_line(args, ctx: dict) -> object:
 
     cache = seed.SeedCache(ctx["alias_cache"])
     if ctx["concept_mode"]:
-        kb = {c["name"]: {"desc": "", "aliases": c["aliases"]}
-              for c in ctx["all_rows"]}   # 概念行无知识文本；KB 块切 docs 层（P1）
+        docs = load_concepts_docs(
+            args.concepts_docs or _docs_sibling(args.concepts))
+        kb = {c["name"]: {"desc": docs.get(c["name"], ""),
+                          "aliases": c["aliases"]}
+              for c in ctx["all_rows"]}   # 知识文本自 docs sidecar 注入（P1 落位）
     else:
         kb = annotate.load_instance_kb(args.instances)
     reconfigure_endpoint("demiwtg_vlm", max_connections=args.vlm_concurrency + 8)
