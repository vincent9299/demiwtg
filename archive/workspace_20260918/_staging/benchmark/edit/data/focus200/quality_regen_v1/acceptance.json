{
  "schema_version": "1.0.0",
  "name": "focus200_quality_regen_v1",
  "purpose": "复杂 edit 题目源图生成后的逐图硬门验收",
  "basis": {
    "review_sample_size": 40,
    "untrusted_count": 16,
    "untrusted_rate": 0.4,
    "carrier_claimed_items": 61,
    "carrier_wrong_items": 7,
    "carrier_item_false_positive_rate": 0.11475409836065574
  },
  "decision": {
    "accepted_when": "all_p0_pass_and_all_p1_thresholds_pass",
    "rejected_when": "any_p0_failure_or_any_p1_threshold_failure",
    "manual_review_required": true,
    "scene_count_above_9_bonus": false
  },
  "p0_rules": [
    {
      "id": "P0_INSTANCE_IDENTITY",
      "requirement": "实例本体必须是明确视觉主体；工作人员、观众、配件、景观元素不得冒充实例本体。抽象概念、品牌或地点须由一个可编辑且可指认的实体化载体表达。"
    },
    {
      "id": "P0_SUBJECT_COMPLETE",
      "requirement": "主体完整入画并留有编辑余量；关键轮廓不得裁边、粘连背景或被明显遮挡。"
    },
    {
      "id": "P0_TWO_VISIBLE_CARRIERS",
      "requirement": "至少两种不同后果载体当前真实可见，每种均须能指出载体位置及其可辨呈现；理论上可能存在不计。",
      "allowed_carriers": [
        "水面倒影",
        "镜面玻璃反光",
        "影子投影",
        "接触叠放",
        "液体容器",
        "仪表指示",
        "可动机构"
      ],
      "evidence": {
        "水面倒影": "水面与可辨倒影同时可见",
        "镜面玻璃反光": "反光面与可辨映像同时可见",
        "影子投影": "影子方向和归属清晰可辨",
        "接触叠放": "接触或承载关系明确可见",
        "液体容器": "容器边界与液面同时可见",
        "仪表指示": "表盘或屏幕读数可辨",
        "可动机构": "关节或活动部件可辨"
      }
    },
    {
      "id": "P0_COUNTABLE_GROUP",
      "requirement": "至少一组同类对象，建议 3 至 5 个且最多 6 个；全部完整、分离、可逐一指认，实际数量与声明精确一致。"
    },
    {
      "id": "P0_GROUP_VARIANTS",
      "requirement": "目标组各对象须有肉眼明显的颜色、朝向或状态差异，并有稳定空间关系；左右对称部件不得作为不同变体或独立主体。"
    },
    {
      "id": "P0_REFERENTS",
      "requirement": "至少两个独立、唯一、轮廓清晰的定位参照物，可与目标形成无歧义的左右、前后或距离关系。"
    },
    {
      "id": "P0_NO_DENSE_UNCOUNTABLE_ELEMENTS",
      "requirement": "不得以密集人群、树林、工具墙、货架小件或其他不可逐一核数元素作为目标组；总人物数必须在 0 至 5 之间且逐个可数。"
    },
    {
      "id": "P0_EVIDENCE_INDEPENDENCE",
      "requirement": "每个复杂度维度须有独立画面证据；同一束光不得同时支撑光照时段和环境作用。"
    },
    {
      "id": "P0_ENVIRONMENT_ACTION",
      "requirement": "环境作用仅由雪、风、水汽、泥水等介质对对象的可见作用支撑；2 分要求同一环境对至少两个对象呈现不同作用。普通窗光、夕阳或聚光灯仅属光照。"
    },
    {
      "id": "P0_PROCESS_AND_MOTION",
      "requirement": "过程时刻 2 分要求至少两个主体处于可见的不同动作或阶段；单主体单动作最多 1 分。动态要素 2 分要求动作与飞溅、轨迹、扬尘或运动模糊等痕迹互证。"
    },
    {
      "id": "P0_PIXEL_CLARITY",
      "requirement": "主体、目标组、定位参照物及后果载体均须有足够像素和清晰度，使编辑结果与传播后果可肉眼判定。"
    }
  ],
  "p1_thresholds": {
    "scene_count": {
      "min": 6,
      "recommended_max": 9,
      "count_only_independently_supported_dimensions": true
    },
    "scene_strong": {
      "min": 3
    },
    "valid_same_class_groups": {
      "min": 1,
      "max_count_per_target_group": 6,
      "require_exact_count": true,
      "require_correct_role": true,
      "require_visible_variants": true
    },
    "valid_referents": {
      "min": 2
    },
    "valid_consequence_carriers": {
      "min_distinct": 2,
      "false_positive_tolerance": 0
    },
    "subject_separable": {
      "exact": 2
    },
    "background_content": {
      "min": 1
    },
    "person_count": {
      "min": 0,
      "max": 5,
      "require_exact": true
    }
  },
  "rejection_reasons": [
    {"code": "INSTANCE_NOT_PRIMARY", "rule": "P0_INSTANCE_IDENTITY"},
    {"code": "INSTANCE_AMBIGUOUS_OR_ABSTRACT", "rule": "P0_INSTANCE_IDENTITY"},
    {"code": "SUBJECT_CROPPED", "rule": "P0_SUBJECT_COMPLETE"},
    {"code": "SUBJECT_OCCLUDED", "rule": "P0_SUBJECT_COMPLETE"},
    {"code": "SUBJECT_NOT_SEPARABLE", "rule": "P0_SUBJECT_COMPLETE"},
    {"code": "CARRIER_COUNT_LT_2", "rule": "P0_TWO_VISIBLE_CARRIERS"},
    {"code": "CARRIER_FALSE_POSITIVE", "rule": "P0_TWO_VISIBLE_CARRIERS"},
    {"code": "CARRIER_EVIDENCE_UNREADABLE", "rule": "P0_TWO_VISIBLE_CARRIERS"},
    {"code": "TARGET_GROUP_MISSING", "rule": "P0_COUNTABLE_GROUP"},
    {"code": "TARGET_GROUP_COUNT_MISMATCH", "rule": "P0_COUNTABLE_GROUP"},
    {"code": "TARGET_GROUP_NOT_COUNTABLE", "rule": "P0_COUNTABLE_GROUP"},
    {"code": "TARGET_GROUP_ROLE_WRONG", "rule": "P0_COUNTABLE_GROUP"},
    {"code": "TARGET_GROUP_VARIANTS_NOT_VISIBLE", "rule": "P0_GROUP_VARIANTS"},
    {"code": "SYMMETRIC_PARTS_AS_VARIANTS", "rule": "P0_GROUP_VARIANTS"},
    {"code": "REFERENT_COUNT_LT_2", "rule": "P0_REFERENTS"},
    {"code": "REFERENT_AMBIGUOUS", "rule": "P0_REFERENTS"},
    {"code": "DENSE_UNCOUNTABLE_ELEMENTS", "rule": "P0_NO_DENSE_UNCOUNTABLE_ELEMENTS"},
    {"code": "PERSON_COUNT_OUT_OF_RANGE", "rule": "P0_NO_DENSE_UNCOUNTABLE_ELEMENTS"},
    {"code": "PERSON_COUNT_MISMATCH", "rule": "P0_NO_DENSE_UNCOUNTABLE_ELEMENTS"},
    {"code": "SCENE_EVIDENCE_DOUBLE_COUNTED", "rule": "P0_EVIDENCE_INDEPENDENCE"},
    {"code": "ENVIRONMENT_ACTION_UNSUPPORTED", "rule": "P0_ENVIRONMENT_ACTION"},
    {"code": "PROCESS_SCORE_UNSUPPORTED", "rule": "P0_PROCESS_AND_MOTION"},
    {"code": "MOTION_SCORE_UNSUPPORTED", "rule": "P0_PROCESS_AND_MOTION"},
    {"code": "KEY_EVIDENCE_TOO_SMALL_OR_BLURRY", "rule": "P0_PIXEL_CLARITY"},
    {"code": "FORBIDDEN_TEXT_OR_MARK", "rule": "P0_FORBIDDEN_TEXT_AND_MARKS"},
    {"code": "SCENE_COUNT_LT_6", "rule": "p1_thresholds.scene_count"},
    {"code": "SCENE_STRONG_LT_3", "rule": "p1_thresholds.scene_strong"},
    {"code": "BACKGROUND_CONTENT_LT_1", "rule": "p1_thresholds.background_content"}
  ]
}
