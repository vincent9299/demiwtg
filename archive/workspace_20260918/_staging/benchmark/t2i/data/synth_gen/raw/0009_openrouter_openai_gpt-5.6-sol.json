        "content": "[\n  {\n    \"qid\": \"0009-t2i-1\",\n    \"sample_id\": \"0009_广东醒狮_5193b32c.jpg\",\n    \"task\": \"t2i\",\n    \"status\": \"accepted\",\n    \"knowledge_dim\": \"cultural_folk\",\n    \"knowledge_dim_secondary\": [],\n    \"difficulty\": \"L2\",\n    \"evidence_audit\": {\n      \"visible_facts\": [\n        \"画面中央为黄色传统舞狮主体，狮头与披覆身体完整入镜\",\n        \"狮头具有夸张的大眼、宽嘴、额顶装饰和多色彩绘纹样\",\n        \"狮身覆盖黄色绒毛，身体下方可见表演者的裤腿与鞋脚\",\n        \"背景为中式建筑立面，并悬挂多面红色传统旗幡\"\n      ],\n      \"canonical_features\": [\n        \"[solid] 广东醒狮属于南狮体系，传统上以佛山狮与鹤山狮为主要类型\",\n        \"[solid] 佛山传统醒狮的狮头为程式化面具造型，典型结构包括额顶单角、凸起圆眼和宽阔可动下颌\",\n        \"[solid] 传统醒狮通常由两名表演者共同操控：前者操纵狮头，后者弯身形成躯干与后臀，长幅狮被连接前后\",\n        \"[solid] 两人舞动时，狮被下方形成前后两个支撑区，可辨认四条表演者腿或四只鞋脚\"\n      ],\n      \"entity_match\": {\n        \"status\": \"confirmed\",\n        \"reason\": \"图中程式化南狮头、绒毛狮被及双人表演结构与广东醒狮相符，并与 query_label 一致\"\n      },\n      \"trigger_check\": \"prompt 线索『佛山传统醒狮』『民俗表演』『完整全身』→ 所需先验：佛山狮头规范结构与双人操狮构造 → 两个知识单元直接协同、推理步数0 → pass\",\n      \"counterexample_test\": \"check1方向a漏变体：构造黑、红或黄色脸谱及不同传统彩绘的佛山狮，均合法；rubric不以具体配色判分并收入变体。方向b挡视角：旗幡遮住额顶或狮头背对镜头会导致单角不可判；最终prompt限定侧前方、狮头完整无遮挡，故不再合法。方向c透视变形：严格侧面会令双眼重叠；最终prompt限定侧前方而非纯侧面，并以至少一只凸眼清晰可辨为最低条件。check2方向a漏变体：构造长绒狮被、短绒狮被及不同裤装，均为合法双人结构；rubric只判连接与支撑关系并收入变体。方向b挡视角：观众或道具遮住脚部会使人数结构不可判；prompt要求全身及地面接触处无遮挡。方向c透视变形：正面视角会使前后表演者完全重叠；侧前方平视构图使两个支撑区可分。两条check分别使用狮头与狮身下方证据，无同义、因果包含或证据共享；无剩余合法反例 → pass\",\n      \"leak_check\": [\n        {\n          \"check_idx\": 1,\n          \"attribute\": \"额顶单角、凸起圆眼、宽阔可动下颌与程式化彩绘面部\",\n          \"prompt_wording\": \"无（『佛山传统醒狮』为实体与收窄派别名称）\",\n          \"verdict\": \"pass\"\n        },\n        {\n          \"check_idx\": 2,\n          \"attribute\": \"长幅狮被连接前后、双人形成两个支撑区及四条表演者腿脚\",\n          \"prompt_wording\": \"无（『完整全身及地面接触处』仅为可见性要求）\",\n          \"verdict\": \"pass\"\n        }\n      ]\n    },\n    \"gen_prompt\": \"纪实摄影风格的岭南民俗表演：一头佛山传统醒狮在古朴宗祠庭院中做采青前的蓄势跃动。采用侧前方平视构图，醒狮完整全身及地面接触处清晰入镜，不受观众、旗幡或道具遮挡，午后自然光营造热烈节庆氛围。\",\n    \"implicit_checks\": [\n      {\n        \"check\": \"佛山醒狮头具额顶单角、凸起圆眼、宽阔可动下颌和程式化彩绘面部\",\n        \"knowledge\": \"[solid] 佛山传统醒狮采用程式化南狮面具造型，典型结构为额顶单角、凸起圆眼、宽阔且可开合的下颌，并以彩绘纹样组织面部\",\n        \"verified\": true,\n        \"critical\": true,\n        \"weight\": 0.6,\n        \"coverage\": \"narrowed\",\n        \"visual_features\": [\n          \"F1：狮头额顶中央可见一支独立突起的角\",\n          \"F2：面部至少一只眼睛呈明显外凸的大圆眼结构\",\n          \"F3：嘴部具有横向宽阔且与上颌可分辨的下颌轮廓\",\n          \"F4：面部为多色曲线纹样构成的程式化面具，而非写实兽类口鼻\"\n        ],\n        \"visual_probes\": [\n          \"P1：狮头额顶中央是否可见一支独立突起的角？\",\n          \"P2：面部是否至少有一只眼睛呈明显外凸的大圆眼结构？\",\n          \"P3：嘴部是否横向宽阔，并能分辨与上颌分离的下颌轮廓？\",\n          \"P4：面部是否由多色曲线纹样组成，而非写实动物的毛皮口鼻？\"\n        ],\n        \"tier_map\": [\n          \"P1、P2、P3、P4全部回答yes → 2档\",\n          \"四个探针均可见且恰有三个回答yes、一个回答no → 1档\",\n          \"四个探针均可见且回答yes不超过两个 → 0档\",\n          \"任一探针回答不可见，说明狮头或关键部位未达到最低可见条件 → 0档\"\n        ],\n        \"rubric\": {\n          \"0\": \"狮头关键结构中至多两项成立，或狮头被遮挡而无法辨认额顶、眼部或嘴部\",\n          \"1\": \"单角、凸眼、宽阔可动下颌、程式化彩绘四项中明确具备三项\",\n          \"2\": \"额顶单角、凸起圆眼、宽阔可动下颌与程式化彩绘面部四项全部清晰成立\"\n        },\n        \"acceptable_variants\": [\n          \"脸谱可采用黄、红、黑或其他传统主色，具体颜色不影响结构判分\",\n          \"嘴部可以张开或闭合，只要宽阔且上下颌分离结构仍可辨\",\n          \"侧前方角度下仅一只凸眼完整可见，另一只部分受自身结构遮挡\"\n        ],\n        \"visibility_requirement\": \"狮头正面与额顶须完整入镜，至少一只眼、额顶中央和上下颌结构清晰可辨\"\n      },\n      {\n        \"check\": \"醒狮身体呈双人操控构造，前后由狮被连接并形成两个分离的腿脚支撑区\",\n        \"knowledge\": \"[solid] 传统佛山醒狮通常由两名表演者共同操控，前者位于狮头下方，后者弯身形成后臀；长幅狮被连接两人，身体下方形成前后两个支撑区并对应四条表演者腿或四只鞋脚\",\n        \"verified\": true,\n        \"critical\": false,\n        \"weight\": 0.4,\n        \"coverage\": \"narrowed\",\n        \"visual_features\": [\n          \"F1：一幅连续的柔性狮被由狮头后方延伸至抬起的后臀\",\n          \"F2：狮被下方可辨四条由服装覆盖的人腿轮廓或四只鞋脚\",\n          \"F3：四条腿脚分为靠近狮头与靠近后臀的前后两个支撑区\",\n          \"F4：后部支撑者的弯身轮廓在狮被下形成高于腿脚的拱起后臀\"\n        ],\n        \"visual_probes\": [\n          \"P1：是否有一幅连续柔性的披覆物从头部后方延伸至抬起的后部？\",\n          \"P2：披覆物下方是否能辨认四条穿着服装的人腿轮廓或四只鞋脚？\",\n          \"P3：这些腿脚是否分成靠近头部和靠近后部的两个支撑区？\",\n          \"P4：后方支撑区上方是否形成由弯身轮廓撑起的拱起后部？\"\n        ],\n        \"tier_map\": [\n          \"P1、P2、P3、P4全部回答yes → 2档\",\n          \"四个探针均可见且恰有三个回答yes、一个回答no → 1档\",\n          \"四个探针均可见且回答yes不超过两个 → 0档\",\n          \"任一探针回答不可见，说明狮身下方或前后结构未达到最低可见条件 → 0档\"\n        ],\n        \"rubric\": {\n          \"0\": \"至多两项双人结构特征成立，或画成四足动物、单人吉祥物及无法辨认腿脚的整块身体\",\n          \"1\": \"连续狮被、四条腿脚、前后支撑区、拱起后臀四项中明确具备三项\",\n          \"2\": \"连续狮被连接头尾，四条表演者腿脚分属前后支撑区，后方弯身形成拱起后臀\"\n        },\n        \"acceptable_variants\": [\n          \"狮被可为长绒、短绒或鳞片纹布料，只要前后连接关系可辨\",\n          \"表演者裤装和鞋履颜色可变化，不影响四条腿脚及前后分区判定\",\n          \"跃动时一只脚可以离地，但四条腿或四只鞋脚仍须可辨\"\n        ],\n        \"visibility_requirement\": \"醒狮须完整侧前方入镜，狮被下缘、前后支撑区及全部腿脚均清晰可辨\"\n      }\n    ],\n    \"unverified_observations\": [],\n    \"facet_tags\": [\n      \"fullbody_action\",\n      \"real_world_scene\",\n      \"composition\",\n      \"lighting_atmosphere\"\n    ],\n    \"facet_diagnostic\": [\n      \"cultural_elements\"\n    ],\n    \"gate_spec\": {\n      \"required_subjects\": [\n        \"传统舞狮主体\"\n      ],\n      \"theme_definition\": \"佛山传统醒狮在岭南宗祠庭院中进行民俗表演\"\n    },\n    \"expected_failure_modes\": [\n      \"将狮头画成写实狮子、北狮或普通吉祥物头套，缺少佛山醒狮的单角、凸眼和可动宽嘴\",\n      \"将狮身画成真实四足动物或单人玩偶，未呈现狮被连接的双人操控结构\",\n      \"正面重叠或道具遮挡导致后方表演者及腿脚支撑关系无法辨认\"\n    ],\n    \"notes\": \"采用佛山传统醒狮收窄广东醒狮品类，以独立的狮头形制知识和双人操控结构知识构成L2协同探针。\"\n  }\n]",
