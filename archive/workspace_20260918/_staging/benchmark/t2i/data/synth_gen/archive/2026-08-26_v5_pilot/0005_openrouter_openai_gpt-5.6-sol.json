      "message": {
        "content": "[\n  {\n    \"qid\": \"0005-t2i-1\",\n    \"sample_id\": \"0005_国际空间站_cbdf800f.jpg\",\n    \"task\": \"t2i\",\n    \"status\": \"accepted\",\n    \"knowledge_dim\": \"tech_aerospace\",\n    \"knowledge_dim_secondary\": [\n      \"physics_commonsense\"\n    ],\n    \"difficulty\": \"L2\",\n    \"evidence_audit\": {\n      \"visible_facts\": [\n        \"画面中央是一座由多个舱段、外露桁架和大型矩形板阵组成的轨道设施\",\n        \"设施左侧停靠着一架具有三角翼和黑白隔热外观的航天飞机形载具\",\n        \"下方可见带有云层的蓝色地球弧面，地球之外为黑色太空\",\n        \"大型板阵呈棕金色至深褐色，表面具有规则网格\"\n      ],\n      \"canonical_features\": [\n        \"[solid] 国际空间站是模块化近地轨道空间站，标志性外观包括长横向桁架、成组圆柱形加压舱段和多组宽大矩形太阳能电池阵列\",\n        \"[solid] 联盟号载人飞船由轨道舱、返回舱和仪器服务舱串联组成，服务舱两侧各有一块矩形太阳能电池板\",\n        \"[solid] 从近地轨道广角观察地球边缘时，可见弧形地平线及狭薄的蓝色大气层边缘，其外侧天空保持黑色\"\n      ],\n      \"entity_match\": {\n        \"status\": \"confirmed\",\n        \"reason\": \"图中长桁架、模块化舱段及多组大型太阳翼与国际空间站的规范形制一致，也与 query_label 相符\"\n      },\n      \"trigger_check\": \"prompt 线索“国际空间站”“联盟号飞船”“白昼地球”“附近飞船广角视角” → 所需先验：国际空间站结构、联盟号外形、近地轨道所见地球边缘形态 → 推理步数 0，需协同召回三个知识单元 → pass\",\n      \"counterexample_test\": \"候选反例：现役国际空间站带有覆盖旧太阳翼部分区域的 iROSA 新太阳翼，属于合法时代配置，已纳入 check1 变体；联盟号因停靠角度仅露出部分舱段，属于合法透视遮挡，已纳入 check2 变体；地球大气边缘因曝光而偏白蓝，属于合法成像差异，已纳入 check3 变体 → 无剩余合法反例 → pass\"\n    },\n    \"gen_prompt\": \"写实航天摄影：从附近飞船视角拍摄完整的国际空间站，白昼地球占据下方背景，一艘联盟号飞船停靠在空间站端部接口。采用广角横幅构图，空间站居中并主导画面，阳光从左上方照来，呈现清晰工程细节与宏大尺度感。\",\n    \"implicit_checks\": [\n      {\n        \"check\": \"国际空间站具有长横向桁架、成组圆柱形舱段和多组宽大矩形太阳能电池阵列\",\n        \"knowledge\": \"[solid] 国际空间站是模块化轨道设施，其标志性结构由长横向桁架、多个圆柱形加压舱段及多组大型矩形太阳能电池阵列构成\",\n        \"verified\": true,\n        \"critical\": true,\n        \"weight\": 0.5,\n        \"rubric\": {\n          \"0\": \"空间站缺失或不可辨，或被画成单体圆盘、火箭、环形站等不同类型设施\",\n          \"1\": \"可辨为国际空间站，但长桁架、圆柱舱段、成组矩形太阳翼中至少一类缺失或形制错误\",\n          \"2\": \"长横向桁架、成组圆柱舱段及多组宽大矩形太阳翼全部清楚呈现\"\n        },\n        \"acceptable_variants\": [\n          \"太阳翼因受光角度呈金色、棕色、铜色或近黑色\",\n          \"采用安装有 iROSA 新太阳翼的现役国际空间站配置\",\n          \"局部结构被其他舱段遮挡，但三类标志性结构均有可辨部分\"\n        ],\n        \"visibility_requirement\": \"空间站主体大部分入画，桁架、舱段和太阳翼均达到可辨尺寸\"\n      },\n      {\n        \"check\": \"停靠载具呈联盟号的短粗串联舱段轮廓，服务舱两侧各展开一块矩形太阳能电池板\",\n        \"knowledge\": \"[solid] 联盟号飞船由轨道舱、钟形返回舱和仪器服务舱依次串联，服务舱两侧配置一对矩形太阳能电池板\",\n        \"verified\": true,\n        \"critical\": false,\n        \"weight\": 0.3,\n        \"rubric\": {\n          \"0\": \"停靠载具缺失，或画成有翼航天飞机、单体胶囊、货运飞船等非联盟号形制\",\n          \"1\": \"载具具有联盟号式短粗轮廓，但串联舱段或两侧矩形太阳翼仅呈现其中一项\",\n          \"2\": \"短粗串联舱段与服务舱两侧一对矩形太阳翼同时清楚呈现\"\n        },\n        \"acceptable_variants\": [\n          \"轨道舱因连接空间站而被接口结构部分遮挡\",\n          \"透视缩短使三个舱段相互重叠，但串联关系仍可辨\",\n          \"一侧太阳翼因观察角度显得较窄\"\n        ],\n        \"visibility_requirement\": \"停靠飞船至少一半外形可见，且舱段轮廓与太阳翼位置能够辨认\"\n      },\n      {\n        \"check\": \"地球边缘呈可辨弧形，并有狭薄蓝色大气层边缘与外侧黑色太空相接\",\n        \"knowledge\": \"[solid] 国际空间站运行于近地轨道；从该高度的广角视野观察地球边缘，可见地球曲率和薄层大气辉光，而大气层外的天空为黑色\",\n        \"verified\": true,\n        \"critical\": false,\n        \"weight\": 0.2,\n        \"rubric\": {\n          \"0\": \"背景被画成地面视角的平直地平线与蓝色天空，或地球边缘和黑色太空均不可辨\",\n          \"1\": \"黑色太空存在，但弧形地球边缘与狭薄大气层边缘仅有一项清楚可辨\",\n          \"2\": \"弧形地球边缘、狭薄蓝色大气层边缘及外侧黑色太空三者同时可辨\"\n        },\n        \"acceptable_variants\": [\n          \"强曝光使大气层薄边呈白蓝色或青蓝色\",\n          \"云层覆盖大部分地表，但地球弧形边缘仍然可辨\"\n        ],\n        \"visibility_requirement\": \"画面包含一段足以判断曲率的地球边缘，并同时保留其外侧太空区域\"\n      }\n    ],\n    \"unverified_observations\": [],\n    \"facet_tags\": [\n      \"subject_prominence\",\n      \"spatial_2d\",\n      \"composition\",\n      \"lighting_atmosphere\"\n    ],\n    \"facet_diagnostic\": [\n      \"tech_machinery\",\n      \"nature_morphology\"\n    ],\n    \"gate_spec\": {\n      \"required_subjects\": [\n        \"大型轨道空间站\"\n      ],\n      \"theme_definition\": \"国际空间站位于白昼地球上空的写实轨道摄影场景\"\n    },\n    \"expected_failure_modes\": [\n      \"把国际空间站简化成单体舱或科幻环形站，缺少长桁架、模块舱段与成组太阳翼\",\n      \"把联盟号画成航天飞机或单体胶囊，遗漏串联舱段和两侧太阳翼\",\n      \"将轨道背景画成地面蓝天，未呈现地球曲率、薄层大气边缘与黑色太空\"\n    ],\n    \"notes\": \"按指定 L2 出题，以国际空间站、联盟号及近地轨道地球边缘三个独立知识单元形成协同召回，且各 check 使用不同视觉证据。\"\n  }\n]",
