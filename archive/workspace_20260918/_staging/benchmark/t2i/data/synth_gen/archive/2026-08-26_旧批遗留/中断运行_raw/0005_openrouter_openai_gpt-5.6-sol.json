        "content": "[\n  {\n    \"qid\": \"0005-t2i-1\",\n    \"sample_id\": \"0005_尘封十三载_a1fba45a.jpg\",\n    \"task\": \"t2i\",\n    \"knowledge_dim\": \"film_anime_game\",\n    \"difficulty\": \"L2\",\n    \"evidence_audit\": {\n      \"visible_facts\": [\n        \"海报前部为一名短黑发男性的正面近景，神情严肃克制\",\n        \"后部叠加同一男性的大幅侧脸轮廓，形成双层人物结构\",\n        \"男性具有偏长脸型、浓直眉、狭长眼、直鼻、薄唇与轻微胡茬\",\n        \"前部人物穿深色翻领外套，后部人物可见灰色织物衣领\",\n        \"背景含模糊的手写调查痕迹与照片状方块，具有案件侦查氛围\",\n        \"画面采用深蓝青色低明度调色，并以侧向冷光塑造面部\",\n        \"海报可见陈晓与陆行知的对应标注\"\n      ],\n      \"anchor_features\": [\n        \"陆行知由陈晓饰演，其视觉锚点为偏长脸型、浓直眉、狭长眼、直鼻和薄唇\",\n        \"作品视觉识别采用同一人物正侧轮廓并置的心理悬疑构图\",\n        \"深蓝青低明度影调与调查线索背景共同构成刑侦悬疑质感\",\n        \"故事核心涉及同一人物跨越十三年追查旧案的时间变化\"\n      ],\n      \"trigger_check\": \"能。提示词明示作品名、陆行知及层叠人物对核心叙事的暗示；掌握该剧的模型可结合角色演员对应关系与十三年追案设定，推出特定面貌及同一人物两个年龄阶段。\",\n      \"counterexample_test\": \"曾尝试以陌生男性或两名不同人物完成层叠构图，但会破坏指定作品的角色身份与跨十三年叙事；因此无法构成同时符合该IP设定而违反校验点的合理画面。\"\n    },\n    \"gen_prompt\": \"为网剧《尘封十三载》创作一张全新横版概念剧照：陆行知独自在昏暗的旧档案室翻阅积灰卷宗，窗外正下夜雨；运用层叠人像暗示本剧的核心叙事，写实电影摄影，深蓝青低明度色调，侧向冷光，气氛压抑克制，场景细节清晰。\",\n    \"implicit_checks\": [\n      {\n        \"check\": \"主体面貌同时呈现偏长脸型、浓直眉、狭长眼、直鼻、薄唇与轻微胡茬中的至少五项\",\n        \"knowledge\": \"[solid] 样本海报直接标明陈晓饰演陆行知；上述六项均为图中角色可见的稳定面部识别特征。\",\n        \"verified\": true,\n        \"weight\": 0.5,\n        \"rubric\": {\n          \"0\": \"仅符合零至两项面部特征，或呈现明显不同的圆脸、宽鼻与浓密络腮胡\",\n          \"1\": \"六项特征中清楚符合三至四项，但其余结构模糊或存在明显偏差\",\n          \"2\": \"六项特征中至少五项清楚成立，整体面部轮廓与角色视觉锚点一致\"\n        },\n        \"acceptable_variants\": [\n          \"胡茬因冷光较弱而不明显，但其余五项面部特征清楚成立\",\n          \"人物采用四分之三侧面，仍能辨认至少五项稳定特征\"\n        ]\n      },\n      {\n        \"check\": \"两个形象具有相同骨相，其中一者皮肤平整青涩，另一者带眼周纹理与成熟疲惫感\",\n        \"knowledge\": \"[solid] 《尘封十三载》的核心刑侦叙事跨越十三年，同一角色陆行知存在前后两个时期；[solid] 年龄增长通常表现为眼周纹理、面部软组织变化与更成熟的神态。两条知识需组合后才能确定层叠形象的视觉关系。\",\n        \"verified\": true,\n        \"weight\": 0.5,\n        \"rubric\": {\n          \"0\": \"两个形象明显属于不同人物，或二者在年龄状态上完全没有可见区别\",\n        