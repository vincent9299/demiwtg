        "content": "[\n  {\n    \"qid\": \"0004-t2i-1\",\n    \"sample_id\": \"0004_和硕恪靖公主府_1d2ae4ab.webp\",\n    \"task\": \"t2i\",\n    \"knowledge_dim\": \"geo_landmark\",\n    \"difficulty\": \"L2\",\n    \"evidence_audit\": {\n      \"visible_facts\": [\n        \"画面中央是一座单层传统建筑，立面接近左右对称\",\n        \"屋面铺设灰色筒瓦，屋脊两端设有向上卷曲的装饰构件\",\n        \"立面采用朱红色木构门窗，中央设入口，两侧排列格栅窗扇\",\n        \"檐口下方存在蓝绿为主并夹有红黄纹样的彩绘装饰带\",\n        \"建筑前方为铺装庭院与居中的石质台阶\"\n      ],\n      \"anchor_features\": [\n        \"灰瓦单层屋面与卷曲脊端装饰\",\n        \"中央入口和两侧红色格栅窗构成的对称立面\",\n        \"檐下连续分布的多色彩绘装饰带\",\n        \"正房前方的居中台阶与院落空间\"\n      ],\n      \"trigger_check\": \"能。提示词明确给出呼和浩特、和硕恪靖公主府及标志性正房，模型可调用地标外观知识，并结合北方传统府邸形制推出各校验点。\",\n      \"counterexample_test\": \"曾尝试用普通现代仿古院落替代，但会失去该正房的屋面、门窗和彩绘组合；在主体完整可见的前提下，无法构造既符合指定地标又同时违反这些校验点的合理画面。\"\n    },\n    \"gen_prompt\": \"创作一幅彩色写实建筑摄影：表现呼和浩特和硕恪靖公主府的标志性正房，从院落斜前方取景，主体完整居中并带出两侧院墙，采用柔和日间自然光，氛围肃静，呈现历史遗址实拍质感。\",\n    \"implicit_checks\": [\n      {\n        \"check\": \"正房屋面铺灰色筒瓦，水平屋脊两端各有向上卷曲的装饰构件\",\n        \"knowledge\": \"[solid，样本图核实] 和硕恪靖公主府该标志性正房采用灰色筒瓦屋面，脊端具有成对上卷装饰，这是其可视识别特征之一。\",\n        \"verified\": true,\n        \"weight\": 0.4,\n        \"rubric\": {\n          \"0\": \"未出现传统瓦屋面，或画成玻璃幕墙、平顶及彩色琉璃瓦建筑\",\n          \"1\": \"出现灰瓦屋面，但筒瓦排列或两端上卷装饰仅有一项可见\",\n          \"2\": \"灰色筒瓦成排覆盖屋面，水平屋脊两端均有上卷装饰构件\"\n        },\n        \"acceptable_variants\": [\n          \"斜向视角造成一侧脊端尺寸较小，但两端装饰仍可辨认\",\n          \"瓦面因柔和光线呈灰褐色，但未变成彩色琉璃瓦\"\n        ]\n      },\n      {\n        \"check\": \"正房立面以中央门洞为轴，两侧均排列朱红色木框格栅窗扇\",\n        \"knowledge\": \"[solid，样本图核实] 该正房正立面具有中轴布局，中央为门洞，两侧配置朱红色木框格栅窗扇，构成接近镜像的排列关系。\",\n        \"verified\": true,\n        \"weight\": 0.3,\n        \"rubric\": {\n          \"0\": \"中央门洞缺失，或立面主要由现代玻璃窗、金属门及白墙组成\",\n          \"1\": \"中央门洞存在，但仅一侧有格栅窗扇，或木框未呈朱红色\",\n          \"2\": \"中央门洞位于立面轴线，两侧均有成组朱红木框格栅窗扇\"\n        },\n        \"acceptable_variants\": [\n          \"中央木门处于关闭、半开或完全开启状态\",\n          \"透视使两侧窗组宽度不同，但其对应排列关系仍然成立\"\n        ]\n      },\n      {\n        \"check\": \"屋檐下设置连续彩绘装饰带，包含蓝绿底色以及红黄纹样\",\n        \"knowledge\": \"[solid，样本图核实] 样本中的檐下装饰为连续多色彩绘，以蓝绿区域为主并穿插红黄纹样，与素色墙面形成明确区分。\",\n        \"verified\": true,\n        \"weight\": 0.3,\n        \"rubric\": {\n          \"0\": \"檐下完全没有彩绘装饰，或仅呈单一水泥灰色构件\",\n          \"1\": \"檐下存在彩绘，但只有单一颜色，或未形成横向连续装饰带\",\n          \"2\": \"檐下彩绘横向连续，蓝绿色区域与红黄色纹样均清楚可辨\"\n        },\n        \"acceptable_variants\": [\n          \"彩绘因年代感而降低饱和度，但蓝绿与红黄两组色彩仍可区分\",\n          \"部分装饰带被柱体或透视遮挡，其余区域仍呈连续多色纹样\"\n        ]\n      }\n    ],\n    \"facet_tags\": [\n      \"landmark_identity\",\n      \"cultural_elements\",\n      \"real_world_scene\",\n      \"composition\"\n    ],\n    \"gate_spec\": {\n      \"required_subjects\": [\n        \"和硕恪靖公主府标志性正房\"\n      ],\n      \"theme_definition\": \"呼和浩特和硕恪靖公主府正房及其传统院落环境的写实建筑摄影\"\n    },\n    \"expected_failure_modes\": [\n      \"将主体画成黄琉璃瓦宫殿或现代商业仿古建筑，屋面形制错误\",\n      \"门窗改成普通玻璃窗或金属门，丢失中轴排列的红色格栅木构\",\n      \"檐下装饰被简化成纯色横梁，缺少蓝绿与红黄组合的连续彩绘\"\n    ],\n    \"notes\": \"以地标名称触发对正房屋面、门窗和彩绘三组联合识别特征的知识召回。\"\n  }\n]",
