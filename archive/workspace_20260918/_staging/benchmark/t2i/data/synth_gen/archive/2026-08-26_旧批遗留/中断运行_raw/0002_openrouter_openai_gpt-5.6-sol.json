      "message": {
        "content": "[\n  {\n    \"qid\": \"0002-t2i-1\",\n    \"sample_id\": \"0002_百岁兰_54128e86.jpg\",\n    \"task\": \"t2i\",\n    \"knowledge_dim\": \"biology_nature\",\n    \"difficulty\": \"L2\",\n    \"evidence_audit\": {\n      \"visible_facts\": [\n        \"主体生长在浅褐色沙砾地表，周围环境干燥且日照强烈\",\n        \"植株具有贴近地面的深褐色粗糙基部，表面可见不规则裂纹\",\n        \"绿色器官宽而扁平，具有清晰的纵向平行纹理，并出现卷曲和撕裂\",\n        \"植株中央附近分布多簇橙红至褐色的小型穗状结构\"\n      ],\n      \"anchor_features\": [\n        \"一对终生持续生长的宽大叶片可因纵裂呈现多条带状裂片\",\n        \"低矮粗糙的木质化冠部贴近荒漠地表\",\n        \"生殖期在冠部附近形成成簇的球果状结构\"\n      ],\n      \"trigger_check\": \"能。提示词明确指定成年、处于繁殖季的百岁兰，并要求植物学可辨识细节；模型可由实体知识组合推出叶片来源、低矮冠部和球果形态。\",\n      \"counterexample_test\": \"曾尝试以多叶莲座或开花灌木满足荒漠植物场景，但两者均不具百岁兰的物种识别结构；在保持主体可被植物学辨认为百岁兰的前提下，无法构造违反两项校验的合理画面。\"\n    },\n    \"gen_prompt\": \"一幅自然史博物馆级写实生态插画：纳米布荒漠中处于繁殖季的成年百岁兰作为唯一主体，采用低机位三分之四视角，四周铺着赭色沙砾与零散岩块，烈日形成硬朗侧光，强调长期风沙侵蚀后的生存状态和可供植物学辨认的细节。\",\n    \"implicit_checks\": [\n      {\n        \"check\": \"所有绿色长带呈现为基部同一对宽叶纵裂后的连续部分，而不是多枚独立萌发的狭叶\",\n        \"knowledge\": \"[solid] 百岁兰一生只形成一对真叶，两枚真叶由基部持续生长，老化和风蚀会使其沿纵向撕裂成多条带状部分。\",\n        \"verified\": true,\n        \"weight\": 0.5,\n        \"rubric\": {\n          \"0\": \"画成具有大量独立叶柄的莲座、灌木或多叶丛，无法看出同一对宽叶的来源\",\n          \"1\": \"出现宽长绿色带状部分，但根部连接被遮挡，或其中部分明显表现为独立新叶\",\n          \"2\": \"两枚宽叶从冠部相对位置伸出，沿长度方向反复撕裂，全部裂条仍保持连续来源\"\n        },\n        \"acceptable_variants\": [\n          \"两枚宽叶均严重纵裂，视觉上形成多条互相交叠的带状部分\",\n          \"一枚宽叶部分被沙砾或另一枚宽叶遮挡，但其基部连接仍可辨认\"\n        ]\n      },\n      {\n        \"check\": \"中央邻近区域具有成簇的红褐色球果状结构，不表现为带鲜艳花瓣的被子植物花朵\",\n        \"knowledge\": \"[solid] 百岁兰属于裸子植物，雌雄异株，生殖器官为着生于分枝轴上的球果，不形成典型被子植物花瓣。\",\n        \"verified\": true,\n        \"weight\": 0.5,\n        \"rubric\": {\n          \"0\": \"中央出现具有宽大鲜艳花瓣的花朵，或完全没有可辨识的球果状器官\",\n          \"1\": \"出现褐色穗状物，但形态松散无鳞片感，或与普通花序难以区分\",\n          \"2\": \"冠部邻近处伸出分枝轴，其上成簇排列红褐色小球果，并具有紧密鳞片外观\"\n        },\n        \"acceptable_variants\": [\n          \"表现数量较多、体形较小的红褐色雄球果\",\n          \"表现体形较大、颜色由绿色转为褐色的雌球果\",\n          \"部分球果被宽叶遮挡，但仍有一簇完整结构清晰可见\"\n        ]\n      }\n    ],\n    \"facet_tags\": [\n      \"nature_morphology\",\n      \"subject_prominence\",\n      \"real_world_scene\",\n      \"material_texture\",\n      \"composition\"\n    ],\n    \"gate_spec\": {\n      \"required_subjects\": [\n        \"百岁兰\"\n      ],\n      \"theme_definition\": \"纳米布荒漠中处于生殖期的成年百岁兰写实生态图景\"\n    },\n    \"expected_failure_modes\": [\n      \"把纵裂部分误画成大量独立萌发的狭长叶片，形成龙舌兰式莲座\",\n      \"把球果误画成带有明显花瓣的红色或黄色花朵\",\n      \"将贴地冠部画成高耸直立的棕榈状树干\"\n    ],\n    \"notes\": \"通过成年叶片的特殊生长方式与裸子植物球果形态组合，检验模型对百岁兰物种知识的掌握。\"\n  }\n]",
