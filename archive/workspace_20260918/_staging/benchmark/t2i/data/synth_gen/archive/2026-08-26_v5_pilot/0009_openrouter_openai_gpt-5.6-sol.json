        "content": "[\n  {\n    \"qid\": \"0009-t2i-1\",\n    \"sample_id\": \"0009_广东醒狮_5193b32c.jpg\",\n    \"task\": \"t2i\",\n    \"status\": \"accepted\",\n    \"knowledge_dim\": \"cultural_folk\",\n    \"knowledge_dim_secondary\": [],\n    \"difficulty\": \"L2\",\n    \"evidence_audit\": {\n      \"visible_facts\": [\n        \"画面中央是一具黄色长绒醒狮道具，正面朝向镜头\",\n        \"狮头具有彩绘宽大头壳、凸出圆眼、额部装饰和可开合大口\",\n        \"狮身下方可见表演者的裤脚与鞋，呈舞狮表演状态\",\n        \"背景为中式建筑立面，并悬挂多面红色中文锦旗\"\n      ],\n      \"canonical_features\": [\n        \"[solid] 广东醒狮属于南狮，典型狮头具有彩绘宽大头壳、额顶独角、凸眼和可开合大口，与北狮的全身长毛兽形外观不同\",\n        \"[solid] 醒狮采青所采的“青”通常是悬挂或摆置的生菜等绿叶菜，取吉祥寓意\",\n        \"[solid] 广东醒狮的传统现场伴奏以鼓为节奏核心，并配合锣、钹类打击乐器\"\n      ],\n      \"entity_match\": {\n        \"status\": \"confirmed\",\n        \"reason\": \"图中彩绘宽大狮头、凸眼大口、长绒披身及表演者足部均符合广东南狮形制，与 query_label 和民间表演艺术分类一致\"\n      },\n      \"trigger_check\": \"prompt 线索“广东醒狮”“传统采青”“现场伴奏” → 所需先验：南狮狮头形制、采青对象、醒狮锣鼓乐器组合 → 推理步数为零步直接召回，但需三个知识单元协同 → pass\",\n      \"counterexample_test\": \"候选反例：佛山狮与鹤山狮脸谱比例不同，均属合法广东醒狮，已纳入 check1 变体；地面采青虽属合法形式，但 prompt 明示目标悬在前上方，故不构成本题合法解释；不同尺寸的锣与钹属于合法乐器变体，已纳入 check3 → 无剩余合法反例 → pass\"\n    },\n    \"gen_prompt\": \"写实纪实摄影：广东醒狮在岭南祠堂前进行传统采青表演，醒狮正从高桩上腾跃，扑向悬在前上方的采青目标；数名乐师在侧后方现场伴奏。低机位广角全景，完整收入醒狮、目标与乐队，营造热烈节庆气氛。\",\n    \"implicit_checks\": [\n      {\n        \"check\": \"醒狮呈南狮头部形制，具有彩绘宽大头壳、额顶独角、凸眼和可开合大口\",\n        \"knowledge\": \"[solid] 广东醒狮属于南狮，典型狮头由彩绘宽大头壳、额顶独角、凸眼及可开合大口构成\",\n        \"verified\": true,\n        \"critical\": true,\n        \"weight\": 0.5,\n        \"rubric\": {\n          \"0\": \"醒狮无法辨认，或画成全身兽毛、写实兽脸的北狮或真实狮子形态\",\n          \"1\": \"可辨为南狮，但宽大彩绘头壳、独角、凸眼和开合大口中缺少一至两项\",\n          \"2\": \"宽大彩绘头壳、额顶独角、凸眼与可开合大口四项形制全部清楚呈现\"\n        },\n        \"acceptable_variants\": [\n          \"佛山狮与鹤山狮的传统脸谱比例差异均可\",\n          \"采用红、黄、黑、白或多彩传统脸谱，不限定狮头主色\"\n        ],\n        \"visibility_requirement\": \"狮头正面或四分之三侧面清晰入画，头顶、双眼与口部均可辨认\"\n      },\n      {\n        \"check\": \"采青目标是一束具有清晰叶片形态的绿叶菜\",\n        \"knowledge\": \"[solid] 醒狮“采青”中的青通常使用生菜等成束绿叶菜，具有纳福求吉的文化寓意\",\n        \"verified\": true,\n        \"critical\": false,\n        \"weight\": 0.3,\n        \"rubric\": {\n          \"0\": \"采青目标缺失，或目标明确画成彩球、旗帜、纯花束及其他非绿叶菜物品\",\n          \"1\": \"目标呈绿色植物团块，但叶片形态模糊，无法确认是成束绿叶菜\",\n          \"2\": \"目标清楚呈现为成束绿叶菜，具有可辨的叶片、叶柄或菜株结构\"\n        },\n        \"acceptable_variants\": [\n          \"使用生菜或其他成束新鲜绿叶菜\",\n          \"绿叶菜与红包或红布条系在一起\"\n        ],\n        \"visibility_requirement\": \"采青目标完整或大半入画，叶片轮廓达到可辨程度\"\n      },\n      {\n        \"check\": \"现场伴奏包含一面鼓，并同时出现锣或钹中的至少一种\",\n        \"knowledge\": \"[solid] 广东醒狮传统伴奏以鼓为节奏核心，并配合锣、钹类金属打击乐器\",\n        \"verified\": true,\n        \"critical\": false,\n        \"weight\": 0.2,\n        \"rubric\": {\n          \"0\": \"伴奏区未出现传统鼓、锣或钹，或仅出现吉他、键盘等现代乐器\",\n          \"1\": \"只清楚出现鼓，或只出现锣钹类乐器，传统伴奏组合不完整\",\n          \"2\": \"一面鼓清楚可见，并同时出现锣或钹中的至少一种传统打击乐器\"\n        },\n        \"acceptable_variants\": [\n          \"大锣、小锣或手锣均可\",\n          \"成对铜钹、铙钹或其他醒狮表演常用钹类均可\"\n        ],\n        \"visibility_requirement\": \"伴奏区域至少有两类乐器主体可见，并能根据外形辨认类别\"\n      }\n    ],\n    \"unverified_observations\": [],\n    \"facet_tags\": [\n      \"fullbody_action\",\n      \"real_world_scene\",\n      \"composition\",\n      \"lighting_atmosphere\"\n    ],\n    \"facet_diagnostic\": [\n      \"cultural_elements\"\n    ],\n    \"gate_spec\": {\n      \"required_subjects\": [\n        \"醒狮表演主体\"\n      ],\n      \"theme_definition\": \"广东醒狮在岭南祠堂前进行高桩采青并由乐师现场伴奏的节庆场景\"\n    },\n    \"expected_failure_modes\": [\n      \"将广东醒狮画成真实狮子或北狮式全身兽毛造型，缺少南狮彩绘头壳与独角\",\n      \"把采青目标误画成彩球、花束或旗帜，未呈现成束绿叶菜\",\n      \"伴奏乐队缺少鼓，或使用现代乐器替代传统锣钹\"\n    ],\n    \"notes\": \"题目以广东醒狮为锚，联合考察南狮形制、采青对象与传统伴奏三个独立知识单元，符合指定 L2 难度。\"\n  }\n]",
