        "content": "[\n  {\n    \"qid\": \"0002-t2i-1\",\n    \"sample_id\": \"0002_最终幻想集换式卡牌（Final_Fantasy_TCG）_173b2059.jpg\",\n    \"task\": \"t2i\",\n    \"status\": \"accepted\",\n    \"knowledge_dim\": \"film_anime_game\",\n    \"knowledge_dim_secondary\": [\n      \"brand_commercial\"\n    ],\n    \"difficulty\": \"L2\",\n    \"evidence_audit\": {\n      \"visible_facts\": [\n        \"画面中有八张竖版卡牌，按两行四列排列在白色背景上\",\n        \"多张卡牌顶部可见角色名称，中央为《最终幻想》角色或怪物插画\",\n        \"卡牌左上角可见带数字的彩色晶体状图标，底部有规则文本区域，部分卡牌右下角有数值\",\n        \"八张卡面均覆盖斜向的“SAMPLE”水印\",\n        \"卡牌底部可见SQUARE ENIX版权信息与FINAL FANTASY作品标识\"\n      ],\n      \"canonical_features\": [\n        \"[solid] 最终幻想集换式卡牌的标准前锋卡通常包含左上角元素色晶体状费用图标、顶部名称、主体插画、下部规则区域及右下角力量数值\",\n        \"[solid] 最终幻想集换式卡牌以卡片旋转约90度表示Dull状态，未Dull的场上卡通常保持纵向\",\n        \"[solid] 玩家每受到一点伤害，就将牌库顶一张卡正面置入伤害区，因此三点伤害对应三张正面朝上的伤害区卡牌\"\n      ],\n      \"entity_match\": {\n        \"status\": \"confirmed\",\n        \"reason\": \"图中卡牌的最终幻想角色、SQUARE ENIX版权、作品标识及费用与力量版式共同符合最终幻想集换式卡牌特征，与query_label一致\"\n      },\n      \"trigger_check\": \"prompt线索《最终幻想集换式卡牌》《标准版前锋卡》《3点伤害》《进入Dull状态》→ 所需先验：前锋卡规范版式、Dull的旋转表示法、伤害区置牌规则 → 推理步数0至1步 → pass\",\n      \"counterexample_test\": \"候选反例：Dull卡顺时针或逆时针转向，均为合法解释，已纳入变体；伤害区三张牌轻微重叠或扇形展开，均为合法解释，已纳入变体；不同元素色、角色或闪卡表面不改变标准功能区布局，已纳入变体；无剩余合法反例 → pass\"\n    },\n    \"gen_prompt\": \"写实桌面摄影：一场正在进行的《最终幻想集换式卡牌（Final Fantasy TCG）》对局，牌垫与卡牌占据画面主体。前景清楚展示数张标准版前锋卡；一名玩家已有3点伤害，且一张前锋刚发动需要其进入Dull状态的能力。俯斜近景构图，玩家双手位于画面边缘，柔和室内灯光。\",\n    \"implicit_checks\": [\n      {\n        \"check\": \"至少一张标准前锋卡呈现左上费用晶体、顶部名称区、中央角色插画、下部规则区与右下力量值的规范版式\",\n        \"knowledge\": \"[solid] 最终幻想集换式卡牌的标准前锋卡具有左上角元素色费用晶体、顶部名称、中央插画、下部规则区域和右下角力量数值\",\n        \"verified\": true,\n        \"critical\": true,\n        \"weight\": 0.4,\n        \"rubric\": {\n          \"0\": \"没有可辨认的前锋卡正面，或任一卡面最多只具备一处所述功能区域\",\n          \"1\": \"至少一张卡具备两至四处所述功能区域，但规范版式仍有部分缺失或错位\",\n          \"2\": \"至少一张卡完整具备费用晶体、名称区、插画、规则区及右下力量值五处区域\"\n        },\n        \"acceptable_variants\": [\n          \"费用晶体采用任一合法元素颜色，角色与力量数值可以不同\",\n          \"卡面带有闪卡反光效果，但五处功能区域仍清楚可辨\"\n        ],\n        \"visibility_requirement\": \"至少一张前锋卡正面完整入画，五处主要功能区域能够分辨\"\n      },\n      {\n        \"check\": \"进入Dull状态的前锋卡横向放置，与仍处于正常状态的纵向卡形成约90度方向差\",\n        \"knowledge\": \"[solid规则] 最终幻想集换式卡牌用旋转卡片约90度表示Dull状态；[prompt前提] 一张前锋进入Dull状态 → [第1步] 该前锋应横向放置\",\n        \"verified\": true,\n        \"critical\": false,\n        \"weight\": 0.3,\n        \"rubric\": {\n          \"0\": \"所有可见场上前锋均保持纵向，或没有能够辨认其方向的目标前锋卡\",\n          \"1\": \"存在一张斜置前锋卡，但其方向介于纵向与横向之间，Dull状态不明确\",\n          \"2\": \"至少一张前锋卡明确横向放置，并与可见纵向卡形成约90度方向差\"\n        },\n        \"acceptable_variants\": [\n          \"Dull卡可顺时针或逆时针旋转\",\n          \"场上可以有其他Dull卡，只要至少一张横向前锋清晰可辨\"\n        ],\n        \"visibility_requirement\": \"至少一张横向前锋与一张纵向卡同时可见，且卡片长边方向可判\"\n      },\n      {\n        \"check\": \"独立伤害区中恰有三张正面朝上的卡牌，每张卡面均可与牌库和手牌区分\",\n        \"knowledge\": \"[solid规则] 最终幻想集换式卡牌中每受到一点伤害便将牌库顶一张卡正面置入伤害区；[prompt前提] 玩家已有3点伤害 → [第1步] 伤害区应有三张正面卡牌\",\n        \"verified\": true,\n        \"critical\": false,\n        \"weight\": 0.3,\n        \"rubric\": {\n          \"0\": \"没有独立伤害区，或其中为零至一张、五张以上，或全部以背面展示\",\n          \"1\": \"伤害区有两张或四张卡，或虽有三张但至少一张正反面无法辨认\",\n          \"2\": \"独立伤害区恰有三张正面朝上的卡，三张均可逐一计数并与其他区域区分\"\n        },\n        \"acceptable_variants\": [\n          \"三张伤害卡可以轻微重叠或呈扇形排列，但必须能够逐张计数\",\n          \"伤害区可位于牌垫任一侧，只要与牌库、手牌及场上卡分离\"\n        ],\n        \"visibility_requirement\": \"伤害区完整入画，卡牌数量及正面朝向均能够直接判断\"\n      }\n    ],\n    \"unverified_observations\": [],\n    \"facet_tags\": [\n      \"subject_prominence\",\n      \"real_world_scene\",\n      \"composition\",\n      \"lighting_atmosphere\"\n    ],\n    \"facet_diagnostic\": [\n      \"objects\",\n      \"relational_reasoning\"\n    ],\n    \"gate_spec\": {\n      \"required_subjects\": [\n        \"集换式卡牌对局桌面\"\n      ],\n      \"theme_definition\": \"柔和室内灯光下正在进行的最终幻想集换式卡牌桌面对局\"\n    },\n    \"expected_failure_modes\": [\n      \"将卡牌画成普通扑克牌或其他TCG版式，缺失费用晶体与右下力量值布局\",\n      \"进入Dull状态的前锋仍保持纵向，未用卡片方向变化表达游戏状态\",\n      \"把三点伤害画成生命数字、指示物或错误数量的背面卡，而非三张正面伤害卡\"\n    ],\n    \"notes\": \"指定L2与样本适配：前锋卡版式、Dull状态和伤害区规则构成多个独立知识单元，并包含由三点伤害到三张正面卡的一步确定性演绎。\"\n  }\n]",
