      "message": {
        "content": "[\n  {\n    \"qid\": \"0010-t2i-1\",\n    \"sample_id\": \"0010_咯吱盒_ab6c15c5.jpg\",\n    \"task\": \"t2i\",\n    \"status\": \"accepted\",\n    \"knowledge_dim\": \"cultural_folk\",\n    \"knowledge_dim_secondary\": [],\n    \"difficulty\": \"L2\",\n    \"evidence_audit\": {\n      \"visible_facts\": [\n        \"画面中有大量金黄色的小块油炸食品，外形以矩形、菱形和短卷段为主\",\n        \"部分食品的切口露出棕褐色馅料\",\n        \"一把漏勺托着炸制完成的食品，下面是正在冒泡的油锅\",\n        \"画面叠加了可辨认的“炸咯吱盒”白色书法字样\"\n      ],\n      \"canonical_features\": [\n        \"[solid] 咯吱盒是北京及周边地区的传统油炸小吃，以摊成的咯吱皮包卷馅料，切成短段或折成小块后炸制\",\n        \"[solid] 成品通常呈短小矩形、菱形或卷段状，油炸后的薄皮表面金黄并可出现细小鼓泡\",\n        \"[solid] 切开的咯吱盒可见薄皮包围较紧实的馅料，不是发面包心或空心膨化结构\",\n        \"[solid] 咯吱盒存在素馅与肉馅等家庭和地域做法差异，不能用单一馅料颜色判定身份\"\n      ],\n      \"entity_match\": {\n        \"status\": \"confirmed\",\n        \"reason\": \"图中文字、短小油炸包馅形态及切口结构均与 query_label“咯吱盒”一致。\"\n      },\n      \"trigger_check\": \"prompt 线索“咯吱盒”“北京年节家庭厨房”“切开一个展示内部” → 所需先验：咯吱盒的成品外形与油炸表皮、包馅切面结构 → 推理步数为零步直接召回两个知识单元 → pass\",\n      \"counterexample_test\": \"候选反例：家庭做法呈矩形、菱形或短卷段，均属合法形态，已纳入 check1 变体；候选反例：内部采用素馅或肉馅，均属合法解释，已纳入 check2 变体；画成饺子或空心炸面片属于实体知识错误，不是合法反例 → 无剩余合法反例 → pass\"\n    },\n    \"gen_prompt\": \"纪实美食摄影：北京年节的家庭厨房里，一盘刚出锅的咯吱盒作为画面主体摆在木桌上，旁边切开一个样品展示内部。采用近景俯拍与暖色侧光，背景保留简洁的传统备餐环境。\",\n    \"implicit_checks\": [\n      {\n        \"check\": \"咯吱盒主体呈短小矩形、菱形或卷段状，油炸外表为薄脆表皮并带有细小鼓泡\",\n        \"knowledge\": \"[solid] 咯吱盒由咯吱皮包卷后切段或折成小块炸制，成品通常为短小几何块或卷段，薄皮经油炸形成金黄且带细小鼓泡的表面\",\n        \"verified\": true,\n        \"critical\": true,\n        \"weight\": 0.6,\n        \"rubric\": {\n          \"0\": \"主体呈普通饺子、春卷、油条或厚面包块，既无短小块段形态，也无薄皮鼓泡表面\",\n          \"1\": \"短小块段形态与薄皮鼓泡表面仅有一项清楚符合，另一项缺失或无法辨认\",\n          \"2\": \"主体清楚呈短小矩形、菱形或卷段状，同时具有可辨的薄脆鼓泡油炸表面\"\n        },\n        \"acceptable_variants\": [\n          \"不同家庭做法可呈矩形小块、菱形小块或短圆柱卷段\",\n          \"边角在炸制中轻微翘起或开裂，但主体形态与薄皮表面仍可辨\"\n        ],\n        \"visibility_requirement\": \"至少三块主体食品轮廓完整过半，且其中一块的外皮表面细节清晰可辨。\"\n      },\n      {\n        \"check\": \"切开样品的截面表现为薄皮包围较紧实的馅料，而非发面组织或完全空心结构\",\n        \"knowledge\": \"[solid] 咯吱盒以薄咯吱皮包卷馅料后切段炸制，因此切面应见薄皮围住紧实馅心；馅料可因家庭做法不同而变化\",\n        \"verified\": true,\n        \"critical\": false,\n        \"weight\": 0.4,\n        \"rubric\": {\n          \"0\": \"没有可辨切面，或切面呈发面气孔、面包瓤、完全空腔而看不到被薄皮包围的馅料\",\n          \"1\": \"切面中能看到馅料或薄皮之一，但遮挡、模糊或结构混乱，无法同时确认包馅关系\",\n          \"2\": \"切面清楚显示外层薄皮围住较紧实馅料，皮层、馅心及二者包裹关系均可辨\"\n        },\n        \"acceptable_variants\": [\n          \"馅料可为棕褐色肉馅，也可为含蔬菜碎的素馅\",\n          \"切面可因油炸产生少量碎屑，但薄皮包馅结构仍清楚\"\n        ],\n        \"visibility_requirement\": \"至少一个切开样品的截面朝向镜头，皮层与馅心均达到可辨程度。\"\n      }\n    ],\n    \"unverified_observations\": [\n      \"[likely] 样本中的棕褐色馅料可能含肉或调味豆制品，仅凭图片无法确定具体配方，不进入 check。\"\n    ],\n    \"facet_tags\": [\n      \"subject_prominence\",\n      \"real_world_scene\",\n      \"composition\",\n      \"lighting_atmosphere\"\n    ],\n    \"facet_diagnostic\": [\n      \"cultural_elements\",\n      \"objects\"\n    ],\n    \"gate_spec\": {\n      \"required_subjects\": [\n        \"盘装油炸小吃\"\n      ],\n      \"theme_definition\": \"北京年节家庭厨房中的咯吱盒近景美食摄影。\"\n    },\n    \"expected_failure_modes\": [\n      \"把咯吱盒画成饺子、长春卷或油条，缺失短小块段形态和薄皮鼓泡表面\",\n      \"切面被画成空心膨化面片或松软面包组织，没有薄皮包裹紧实馅料的结构\"\n    ],\n    \"notes\": \"样本具备两项独立且可视判定的传统食品知识，但缺少自然成立的反事实或两步因果链；为避免强行包装反事实，按规则由指定 L3 回退为 L2。\"\n  }\n]",
