        "content": "[\n  {\n    \"qid\": \"0001-t2i-1\",\n    \"sample_id\": \"0001_弗朗索瓦·奥朗德_fe1b47e7.jpg\",\n    \"task\": \"t2i\",\n    \"knowledge_dim\": \"history_event\",\n    \"difficulty\": \"L2\",\n    \"evidence_audit\": {\n      \"visible_facts\": [\n        \"主体为一名正面朝向镜头的中年男性\",\n        \"额头宽阔，发际线较高，深色短发向后梳理\",\n        \"佩戴深色矩形全框眼镜\",\n        \"面部轮廓宽圆，下颌区域较饱满\",\n        \"身穿深蓝色西装、浅蓝色衬衫和深色领带\",\n        \"采用胸部以上的正式肖像构图，背景明亮且虚化\"\n      ],\n      \"anchor_features\": [\n        \"高而呈弧形后退的发际线与宽阔额头\",\n        \"向后梳理的深色短发\",\n        \"深色矩形全框眼镜\",\n        \"宽圆面部与饱满下颌形成的辨识轮廓\",\n        \"正式西装造型和克制亲和的公众形象\"\n      ],\n      \"trigger_check\": \"能；提示词给出人物全名、国家领导人身份和唯一指向其任职国家的礼仪陈设要求，可推出本人外貌及法国视觉标识。\",\n      \"counterexample_test\": \"尝试以普通戴眼镜政客配欧盟标识替代，但既不能形成可辨识的本人形象，也不能唯一指向其任职国家；无法构造完全符合提示词而违反校验点的合理画面。\"\n    },\n    \"gen_prompt\": \"写实国际新闻摄影：弗朗索瓦·奥朗德任国家领导人期间，在正式新闻发布会上站于讲台前回答记者提问，呈现可辨识的本人形象；会场加入能够唯一指向其任职国家的礼仪象征陈设。采用正面中景、均匀室内光和通讯社纪实质感，神态克制亲和。\",\n    \"implicit_checks\": [\n      {\n        \"check\": \"主体人物同时呈现宽阔额头、弧形后退发际线和宽圆下颌轮廓\",\n        \"knowledge\": \"[solid] 弗朗索瓦·奥朗德的稳定外貌特征包括宽阔额头、高而后退的弧形发际线及较宽圆的面部下半区；样本图可直接核实。\",\n        \"verified\": true,\n        \"weight\": 0.4,\n        \"rubric\": {\n          \"0\": \"额前为浓密平直刘海且脸型狭长，关键轮廓均与本人不符\",\n          \"1\": \"仅呈现高发际线或宽圆下颌之一，其余面部比例接近普通政客\",\n          \"2\": \"宽阔额头、弧形后退发际线与宽圆下颌三项均清楚呈现\"\n        },\n        \"acceptable_variants\": [\n          \"头部略微侧转，但额头、发际线和下颌轮廓仍清晰可辨\",\n          \"发色因现场照明显得深棕，整体短发形制保持一致\"\n        ]\n      },\n      {\n        \"check\": \"主体佩戴横向矩形的深色全框眼镜，镜框覆盖双眼外缘附近\",\n        \"knowledge\": \"[solid] 深色矩形全框眼镜是弗朗索瓦·奥朗德公开形象中的稳定辨识特征；样本图可直接核实。\",\n        \"verified\": true,\n        \"weight\": 0.3,\n        \"rubric\": {\n          \"0\": \"完全未佩戴眼镜，或改成圆形、无框及夸张彩色镜架\",\n          \"1\": \"具有近似矩形镜架，但颜色过浅、仅半框或宽度比例明显不符\",\n          \"2\": \"深色矩形全框结构完整，镜架宽度与双眼及面部比例相符\"\n        },\n        \"acceptable_variants\": [\n          \"镜框呈深棕色而非纯黑色\",\n          \"镜片带有轻微现场灯光反射但双眼仍可辨认\"\n        ]\n      },\n      {\n        \"check\": \"礼仪标识至少以蓝白红三条竖向色带、玛丽安娜头像或高卢雄鸡之一明确指向法国\",\n        \"knowledge\": \"[solid] 弗朗索瓦·奥朗德曾任法国国家领导人；法国国旗采用蓝白红三条竖带，玛丽安娜与高卢雄鸡也是公认的法国国家象征。\",\n        \"verified\": true,\n        \"weight\": 0.3,\n        \"rubric\": {\n          \"0\": \"未出现可识别国家标识，或明确使用其他国家的旗色与徽记\",\n          \"1\": \"出现红白蓝配色或欧洲式徽记，但排列错误且不能单独指向法国\",\n          \"2\": \"三色竖带、玛丽安娜头像或高卢雄鸡中至少一项形制准确清晰\"\n        },\n        \"acceptable_variants\": [\n          \"讲台一侧悬挂蓝白红三色竖带旗\",\n          \"讲台正面采用清晰可辨的玛丽安娜头像徽记\",\n          \"会场陈设使用造型明确的高卢雄鸡标志\"\n        ]\n      }\n    ],\n    \"facet_tags\": [\n      \"character_likeness\",\n      \"cultural_elements\",\n      \"real_world_scene\",\n      \"composition\"\n    ],\n    \"gate_spec\": {\n      \"required_subjects\": [\n        \"弗朗索瓦·奥朗德\"\n      ],\n      \"theme_definition\": \"弗朗索瓦·奥朗德以国家领导人身份出席正式新闻发布会的纪实场景\"\n    },\n    \"expected_failure_modes\": [\n      \"生成普通欧洲男性政客，发际线、脸型与本人缺乏对应关系\",\n      \"将标志性矩形全框眼镜遗漏或误画成圆形细框眼镜\",\n      \"使用横向红白蓝条纹、欧盟徽记或其他国家旗帜代替法国标识\"\n    ],\n    \"notes\": \"通过人物稳定外貌与任职国家象征的跨域组合，检验知名政治人物辨识和文化知识。\"\n  }\n]",
