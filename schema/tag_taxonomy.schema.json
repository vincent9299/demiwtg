{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbuddy.local/schemas/tag_taxonomy.schema.json",
  "title": "统一标签体系 Taxonomy",
  "description": "覆盖整棵标签体系（通用分类标签 + IP 分类标签）的 JSON 规范，拆为两个交付文件：taxonomy.json（标签树，节点结构 + KB 字段 + 实例名称列表）与 instances_meta.json（实例级富描述扁平列表）。两者共用本 schema：node 定义树，instance 定义实例元。虚构角色 IP 与其他分支统一存储，不保留个性化表。",
  "type": "object",
  "required": ["schema_version", "meta", "tree"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "本 schema 的版本号，如 1.0.0"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "tree": {
      "$ref": "#/$defs/node",
      "description": "根节点（融合世界标签体系），向下递归构成整棵标签体系"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "description": "数据来源说明" },
        "description": { "type": "string" },
        "stats": { "type": "object", "additionalProperties": true }
      }
    },
    "node": {
      "type": "object",
      "required": ["name", "path", "depth", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "节点显示名" },
        "path": {
          "type": "string",
          "description": "完整分类路径，使用 ' / ' 分隔，从根『融合世界标签体系』起算"
        },
        "depth": { "type": "integer", "minimum": 0, "description": "层级深度，根为 0" },
        "type": {
          "type": "string",
          "enum": ["root", "category", "leaf"],
          "description": "root=根节点；category=含子分类的内部节点；leaf=叶子节点（通常挂实例）"
        },
        "definition": { "type": "string", "description": "[KB] 分类定义，来自 gen_full_enrich" },
        "knowledge_intro": { "type": "string", "description": "[KB] 知识介绍" },
        "aliases": { "type": "array", "items": { "type": "string" }, "description": "[KB] 别名/别称" },
        "representative_cases": { "type": "array", "items": { "type": "string" }, "description": "[KB] 代表案例" },
        "related_tags": { "type": "array", "items": { "type": "string" }, "description": "[KB] 关联标签" },
        "instances": {
          "type": "array",
          "items": { "type": "string" },
          "description": "该分类下的实例名称列表（结构指针，仅为字符串）；实例的富描述见 instances_meta.json（通过 name + category 关联）"
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" },
          "description": "子分类节点；叶子节点省略此字段"
        }
      }
    },
    "instance": {
      "type": "object",
      "required": ["name", "category", "source"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "实例名" },
        "category": {
          "type": "string",
          "description": "所属叶子分类路径（与 node.path 一致，从『IP 分类标签』或对应根支起算）"
        },
        "source": {
          "type": "string",
          "enum": ["curated", "templated", "derived"],
          "default": "derived",
          "description": "curated=人工精确撰写；templated=按分类由大模型生成的富描述；derived=仅由体系派生（暂无富描述）"
        },
        "intro": { "type": "string", "description": "一句话简介" },
        "definition": { "type": "string", "description": "定义" },
        "desc": { "type": "string", "description": "详细描述" }
      }
    }
  }
}
