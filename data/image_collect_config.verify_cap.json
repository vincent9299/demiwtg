{
  "defaults": {
    "mime_allowlist": [
      "image/jpeg",
      "image/png"
    ],
    "max_file_bytes": 10485760,
    "total_budget_bytes": 1073741824,
    "license_allowlist": [
      "CC BY",
      "CC BY-SA",
      "CC0",
      "Public domain",
      "CC BY 4.0",
      "CC BY-SA 4.0",
      "CC BY-NC",
      "CC BY-NC-SA",
      "CC BY-ND",
      "CC BY-NC-ND"
    ],
    "target_count": 4,
    "per_host_min_interval_sec": 1.0,
    "timeout_sec": 30,
    "max_retries": 3,
    "min_resolution": 768,
    "max_per_source": 1,
    "sources": [
      "wikimedia",
      "wikimedia_zh"
    ],
    "unauthorized_sources": []
  },
  "jobs": [
    {
      "tag": "内容作品 IP / 动漫作品 / 儿童动画 / 《小猪佩奇》",
      "query": "Peppa Pig",
      "zh_query": "小猪佩奇"
    },
    {
      "tag": "内容作品 IP / 动漫作品 / 动画电影 / 《千与千寻》",
      "query": "Spirited Away",
      "zh_query": "千与千寻"
    }
  ]
}
